<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<template id="ctnews.homepage" name="Homepage">
    <t t-call="website.layout">
        <!-- Preloader Start -->
        <div id="preloader-active">
            <div class="preloader d-flex align-items-center justify-content-center">
                <div class="preloader-inner position-relative">
                    <div class="preloader-circle"></div>
                    <div class="preloader-img pere-text">
                        <img t-attf-src="ctnews/static/src/img/logo/logo.png" alt=""/>
                    </div>
                </div>
            </div>
        </div>
        <!-- Preloader End -->

        <!-- Trending Area Start -->
        <section class="trending-area fix">
            <div class="container">
                <div class="trending-main pt-2">
                    <!-- Trending Tittle -->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="trending-tittle">
                                <strong>Trending now</strong>
                                <div class="trending-animated">
                                    <ul id="js-news" class="js-hidden">
                                        <li class="news-item"><a href="#">Bangladesh dolor sit amet, consectetur adipisicing elit.</a></li>
                                        <li class="news-item"><a href="#">Spondon IT sit amet, consectetur.......</a></li>
                                        <li class="news-item"><a href="#">Rem ipsum dolor sit amet, consectetur adipisicing elit.</a></li>
                                    </ul>
                                </div>          
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Trending Top -->
                            <t t-if="trending_top">
                                <div class="trending-top mb-30">
                                    <div class="trend-top-img">
                                        <t t-if="trending_top[0]['cover_img']">
                                            <img class="img-fluid rounded" 
                                                t-attf-src="data:image/*;base64,{{trending_top[0]['cover_img']}}"
                                                alt="Cover Image"/>
                                        </t>
                                        <t t-else="">
                                            <img class="img-fluid rounded" 
                                                t-attf-src="https://placehold.co/600x400?text=CTNews"
                                                alt="Cover Image"/>
                                        </t>
                                        <div class="trend-top-cap">
                                            <span class="cool">
                                                <t t-esc="trending_top[0]['category_name']"></t>
                                            </span>
                                            <h2><a t-att-href="trending_top[0]['website_url']">
                                                <t t-esc="trending_top[0]['name']"></t>    
                                            </a></h2>
                                            <p t-esc="trending_top[0]['abstract']"></p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <!-- Trending Bottom -->
                            <div class="trending-bottom">
                                <div class="row">
                                    <t t-foreach="trending_bottom" t-as="article">
                                        <div class="col-lg-4">
                                            <div class="single-bottom mb-35">
                                                <div class="trend-bottom-img mb-30">
                                                    <t t-if="article['cover_img']">
                                                        <img class="img-fluid rounded" 
                                                            t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                                            alt="Cover Image"/>
                                                    </t>
                                                    <t t-else="">
                                                        <img class="img-fluid rounded" 
                                                            t-attf-src="https://placehold.co/600x400?text=CTNews"
                                                            alt="Cover Image"/>
                                                    </t>
                                                </div>
                                                <div class="trend-bottom-cap">
                                                    <span class="color1">
                                                        <t t-esc="article['category_name']" />  <!-- Display category name -->
                                                    </span>
                                                    <h4>
                                                        <a t-att-href="article['website_url']">
                                                            <t t-esc="article['name']" />  <!-- Display article title -->
                                                        </a>
                                                    </h4>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <!-- Trending right -->
                        <div class="col-lg-4">
                            <t t-foreach="trending_side" t-as="article">
                                <div class="trand-right-single d-flex">
                                    <div class="trand-right-img">
                                        <t t-if="article['cover_img']">
                                            <img class="img-fluid rounded" 
                                                t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                                alt="Cover Image"/>
                                        </t>
                                        <t t-else="">
                                            <img class="img-fluid rounded" 
                                                t-attf-src="https://placehold.co/600x400?text=CTNews"
                                                alt="Cover Image"/>
                                        </t>
                                    </div>
                                    <div class="trand-right-cap">
                                        <span class="color1">
                                            <t t-esc="article['category_name']" />  <!-- Display category name -->
                                        </span>
                                        <h4>
                                            <a t-att-href="article['website_url']">
                                                <t t-esc="article['name']" />  <!-- Display article title -->
                                            </a>
                                        </h4>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Trending Area End -->
        <!--   Weekly2-News start -->
        <section class="weekly2-news-area  weekly2-pading gray-bg">
            <div class="container">
                <div class="weekly2-wrapper">
                    <!-- section Tittle -->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="section-tittle mb-30">
                                <h3>Weekly Top News</h3>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="weekly2-news-active dot-style d-flex dot-style">
                                <t t-foreach="weekly_top" t-as="article">
                                    <div class="weekly2-single">
                                        <div class="weekly2-img">
                                            <t t-if="article['cover_img']">
                                                <img class="img-fluid rounded" 
                                                    t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                                    alt="Cover Image"/>
                                            </t>
                                            <t t-else="">
                                                <img class="img-fluid rounded" 
                                                    t-attf-src="https://placehold.co/600x400?text=CTNews"
                                                    alt="Cover Image"/>
                                            </t>
                                        </div>
                                        <div class="weekly2-caption">
                                            <span class="color1"><t t-esc="article['category_name']"></t></span>
                                            <p><t t-esc="article['create_date'].strftime('%Y-%m-%d')"/></p>
                                            <h4><a t-att-href="article['website_url']"><t t-esc="article['name']"/></a></h4>
                                        </div>
                                    </div> 
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>           
        <!-- Whats New Start -->
        <section class="whats-news-area pt-50 pb-20">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="row d-flex justify-content-between">
                            <div class="col-lg-3 col-md-3">
                                <div class="section-tittle mb-30">
                                    <h3>What's New</h3>
                                </div>
                            </div>
                            <div class="col-lg-9 col-md-9">
                                <div class="properties__button">
                                    <!--Nav Button  -->                                            
                                    <nav>                                                                     
                                        <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                            <a class="nav-item nav-link active" id="nav-home-tab" data-toggle="tab" href="#nav-home" role="tab" aria-controls="nav-home" aria-selected="true">All</a>
                                            <t t-foreach="category_data" t-as="data">
                                                <a t-attf-class="nav-item nav-link" 
                                                t-attf-id="nav-{{data['category'].id}}-tab" 
                                                data-toggle="tab" 
                                                t-attf-href="#nav-{{data['category'].id}}"
                                                role="tab" 
                                                t-attf-aria-controls="nav-{{data['category'].id}}" 
                                                t-attf-aria-selected="false">
                                                    
                                                <t t-esc="data['category'].name"/>
                                                </a>
                                            </t>
                                        </div>
                                    </nav>
                                    <!--End Nav Button  -->
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <!-- Nav Cards -->
                                <div class="tab-content" id="nav-tabContent">
                                    <!-- Home card -->
                                    <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">           
                                        <div class="whats-news-caption">
                                            <div class="row">
                                                <div class="col-lg-6 col-md-6">
                                                    <div class="single-what-news mb-100">
                                                        <div class="what-img">
                                                            <img t-attf-src="/ctnews/static/src/img/news/whatNews1.jpg" alt=""/>
                                                        </div>
                                                        <div class="what-cap">
                                                            <span class="color1">Night party</span>
                                                            <h4><a href="#">Welcome To The Best Model  Winner Contest</a></h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 col-md-6">
                                                    <div class="single-what-news mb-100">
                                                        <div class="what-img">
                                                            <img t-attf-src="/ctnews/static/src/img/news/whatNews2.jpg" alt=""/>
                                                        </div>
                                                        <div class="what-cap">
                                                            <span class="color1">Night party</span>
                                                            <h4><a href="#">Welcome To The Best Model  Winner Contest</a></h4>
                                                        </div>
                                                    </div>
                                                </div> 
                                                <div class="col-lg-6 col-md-6">
                                                    <div class="single-what-news mb-100">
                                                        <div class="what-img">
                                                            <img t-attf-src="/ctnews/static/src/img/news/whatNews3.jpg" alt=""/>
                                                        </div>
                                                        <div class="what-cap">
                                                            <span class="color1">Night party</span>
                                                            <h4><a href="#">Welcome To The Best Model  Winner Contest</a></h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 col-md-6">
                                                    <div class="single-what-news mb-100">
                                                        <div class="what-img">
                                                            <img t-attf-src="/ctnews/static/src/img/news/whatNews4.jpg" alt=""/>
                                                        </div>
                                                        <div class="what-cap">
                                                            <span class="color1">Night party</span>
                                                            <h4><a href="#">Welcome To The Best Model  Winner Contest</a></h4>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Category specific cards -->
                                    <t t-foreach="category_data" t-as="data">
                                        <div class="tab-pane fade" 
                                            t-attf-id="nav-{{data['category'].id}}" 
                                            role="tabpanel" 
                                            aria-labelledby="nav-profile-tab">

                                            <div class="whats-news-caption">
                                                <div class="row">
                                                    <t t-foreach="data['articles']" t-as="article">
                                                        <div class="col-lg-6 col-md-6">
                                                            <div class="single-what-news mb-100">
                                                                <div class="what-img">
                                                                    <t t-if="article['cover_img']">
                                                                        <img class="img-fluid rounded" 
                                                                            t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                                                            alt="Cover Image"/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <img class="img-fluid rounded" 
                                                                            t-attf-src="https://placehold.co/600x400?text=CTNews"
                                                                            alt="Cover Image"/>
                                                                    </t>
                                                                </div>
                                                                <div class="what-cap">
                                                                    <span class="color1"><t t-esc="article['category_name']"/></span>
                                                                    <h4><a t-att-href="article['website_url']"><t t-esc="article['name']"/></a></h4>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            <!-- End Nav Card -->
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <!-- Section Tittle -->
                        <div class="section-tittle mb-40">
                            <h3>Follow Us</h3>
                        </div>
                        <!-- Flow Socail -->
                        <div class="single-follow mb-45">
                            <div class="single-box">
                                <div class="follow-us d-flex align-items-center">
                                    <div class="follow-social">
                                        <a href="#"><img t-attf-src="/ctnews/static/src/img/news/icon-fb.png" alt=""/></a>
                                    </div>
                                    <div class="follow-count">  
                                        <span>8,045</span>
                                        <p>Fans</p>
                                    </div>
                                </div> 
                                <div class="follow-us d-flex align-items-center">
                                    <div class="follow-social">
                                        <a href="#"><img t-attf-src="/ctnews/static/src/img/news/icon-tw.png" alt=""/></a>
                                    </div>
                                    <div class="follow-count">
                                        <span>8,045</span>
                                        <p>Fans</p>
                                    </div>
                                </div>
                                    <div class="follow-us d-flex align-items-center">
                                    <div class="follow-social">
                                        <a href="#"><img t-attf-src="/ctnews/static/src/img/news/icon-ins.png" alt=""/></a>
                                    </div>
                                    <div class="follow-count">
                                        <span>8,045</span>
                                        <p>Fans</p>
                                    </div>
                                </div>
                                <div class="follow-us d-flex align-items-center">
                                    <div class="follow-social">
                                        <a href="#"><img t-attf-src="/ctnews/static/src/img/news/icon-yo.png" alt=""/></a>
                                    </div>
                                    <div class="follow-count">
                                        <span>8,045</span>
                                        <p>Fans</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- New Poster -->
                        <div class="news-poster d-none d-lg-block">
                            <img t-attf-src="/ctnews/static/src/img/news/news_card.jpg" alt=""/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Whats New End -->
        
        <!-- End Weekly-News -->
        
        <!--Start pagination -->
