<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<template id="ctnews.category_view" name="Category View">
    <t t-call="website.layout">
        <!-- Category Header Section -->
        <section class="category-section text-white mb-30">
            <div class="container py-5">
                <!-- Category Title -->
                <h1 class="display-1 fw-bold text-uppercase"><t t-esc="category.name"></t></h1>
        
                <!-- Category Description -->
                <p class="lead mt-4">
                    <t t-esc="category.desc"></t>
                </p>
        
                <!-- Category Keywords -->
                <div class="mt-4">
                    <span class="fw-bold text-muted">Keywords:</span>
                    <div class="d-inline-flex flex-wrap mt-2">
                        <t t-foreach="keywords" t-as="keyword">
                            <a href="#" class="category-link"><t t-esc="keyword['name']"/></a>
                        </t>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Trending Area Start -->
        <section class="trending-area fix mb-30">
            <div class="container">
                <div class="trending-main pt-2">
                    <div class="row">
                        <t t-foreach="featured_articles" t-as="article">
                            <div class="col-lg-6">
                                <div class="trending-top mb-2">
                                    <div class="trend-top-img">
                                        <t t-if="article['cover_img']">
                                            <img class="img-fluid rounded" 
                                                t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                                alt="Cover Image"/>
                                        </t>
                                        <t t-else="">
                                            <img class="img-fluid rounded" 
                                                t-attf-src="https://placehold.co/600x400?text=CTNews"
                                                alt="Cover Image"/>
                                        </t>
                                        <div class="trend-top-cap">
                                            <h2><a t-att-href="article['website_url']">
                                                <t t-esc="article['name']"></t>    
                                            </a></h2>
                                            <p t-esc="article['abstract']"></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Articles Section with 8 cols and 4 cols layout -->
        <section class="article-section">
            <div class="container">
                <div class="row">
                    <!-- Left column (8 cols): Display articles -->
                    <div class="col-lg-8 mb-35">
                        <t t-foreach="articles_in_page" t-as="article">  
                            <div class="col-lg-6">
                                <div class="article-cover-img mb-30">
                                    <t t-if="article['cover_img']">
                                        <img class="img-fluid rounded" 
                                            t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                            alt="Cover Image"/>
                                    </t>
                                    <t t-else="">
                                        <img class="img-fluid rounded" 
                                            t-attf-src="https://placehold.co/600x400?text=CTNews"
                                            alt="Cover Image"/>
                                    </t>
                                </div>
                                <div class="article-bottom-cap">
                                    <h4>
                                        <a t-att-href="article['website_url']">
                                            <t t-esc="article['name']" />  <!-- Display article title -->
                                        </a>
                                    </h4>
                                </div>
                            </div>
                        </t>  
                    </div>
            
                    <!-- Right column (4 cols): Display top stories and keywords -->
                    <div class="col-lg-4">
                        <h3>Top stories</h3>
                        <t t-foreach="top_stories" t-as="article">
                            <div class="article-side-list d-flex">
                                <div class="trand-right-img">
                                    <t t-if="article['cover_img']">
                                        <img class="img-fluid rounded" 
                                            t-attf-src="data:image/*;base64,{{article['cover_img']}}"
                                            alt="Cover Image"/>
                                    </t>
                                    <t t-else="">
                                        <img class="img-fluid rounded" 
                                            t-attf-src="https://placehold.co/600x400?text=CTNews"
                                            alt="Cover Image"/>
                                    </t>
                                </div>
                                <div class="trand-right-cap">
                                    <h5>
                                        <a t-att-href="article['website_url']">
                                            <t t-esc="article['name']" />  <!-- Display article title -->
                                        </a>
                                    </h5>
                                </div>
                            </div>
                            <!-- Add a separator bar between articles, but not after the last one -->
                            <t t-set="article_num" t-value="len(top_stories)"></t>
                            <t t-if="article_index + 1 &lt; article_num ">
                                <hr class="my-3"/>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </section>

        <!--Start pagination -->
        <div class="pagination-area pb-45 text-center">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="single-wrap d-flex justify-content-center">
                            <nav aria-label="Page navigation example">
                                <ul class="pagination justify-content-start">
                                    <!-- Previous Button -->
                                    <li t-attf-class="page-item #{'disabled' if page &lt;= 1 else ''}">
                                        <a class="page-link" t-att-href="'%s?page=%s' % (category.website_url, page)">
                                            <span class="flaticon-arrow roted"></span>
                                        </a>
                                    </li>
                                
                                    <!-- Page Number Links -->
                                    <t t-set="range_start" t-value="max(1, page - 2)"/>
                                    <t t-set="range_end" t-value="min(total_pages, page + 2)"/>
                                    <t t-foreach="range(range_start, range_end + 1)" t-as="p">
                                        <li t-attf-class="page-item #{'active' if p == page else ''}">
                                            <a class="page-link" t-att-href="'%s?page=%s' % (category.website_url, p)">
                                                <t t-esc="str(p).zfill(2)"/>
                                            </a>
                                        </li>
                                    </t>
                                
                                    <!-- Next Button -->
                                    <li t-attf-class="page-item #{'disabled' if page &gt;= total_pages else ''}">
                                        <a class="page-link" t-att-href="'%s?page=%s' % (category.website_url, page + 1)">
                                            <span class="flaticon-arrow right-arrow"></span>
                                        </a>
                                    </li>
                                </ul>
                                </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End pagination  -->
    </t>
</template>

</odoo>