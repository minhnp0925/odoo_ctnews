<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    
    <!-- Rule to allow public and portal users to view only published articles -->
    <record model="ir.rule" id="ctnews_article_public">
        <field name="name">Article: public: published only</field>
        <field name="model_id" ref="model_ctnews_article"/>
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>

    <!-- Rule to allow public and portal users to view only active categories -->
    <record model="ir.rule" id="ctnews_category_public">
        <field name="name">Category: active only</field>
        <field name="model_id" ref="model_ctnews_category"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>

</odoo>
